{
  "name": "dsh-api-key-pool",
  "version": "0.5.5",
  "description": "Multi-key round-robin + failover pool for DeepSeek Harness providers.",
  "author": "911218sky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/911218sky/dsh-api-key-pool.git"
  },
  "homepage": "https://github.com/911218sky/dsh-api-key-pool#readme",
  "bugs": "https://github.com/911218sky/dsh-api-key-pool/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "api-key",
    "rotation",
    "failover",
    "round-robin"
  ],
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.9"
  }
}
